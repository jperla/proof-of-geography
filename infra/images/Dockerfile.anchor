# Reproducible static zero-shell, zero-SSH binary builder for AWS Nitro Enclaves (.eif)
#
# Security Invariants (enforced by scripts/release_gate.py):
# - NEVER passes --allow-dev-tee or --allow-dev-prover inside the production EIF image.
# - Final runtime stage is `FROM scratch`: ZERO SSH server (`sshd`), ZERO `/bin/sh` or
#   interactive shell, ZERO package manager, ZERO remote command agent inside the measured EIF.
# - Runs static musl `pog-anchor --cloud-provider aws --vsock-port 7443` inside the Nitro
#   Enclave where `/dev/nsm` is mounted and ephemeral Ed25519 keys + Phase 2 BLAKE3-MAC timing
#   live strictly in isolated enclave RAM (zero network interfaces; parent EC2 runs relay).
FROM rust:1.94-alpine AS builder
RUN apk add --no-cache musl-dev ca-certificates
WORKDIR /src
ENV SOURCE_DATE_EPOCH=1700000000 \
    TZ=UTC \
    LC_ALL=C \
    CARGO_INCREMENTAL=0 \
    RUSTFLAGS="--remap-path-prefix=/src=/pog -C target-feature=+crt-static -C debuginfo=0 -C strip=symbols -C codegen-units=1"
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY config ./config
RUN cargo build --release --locked --bin pog-anchor \
    && mkdir -p /out \
    && cp target/release/pog-anchor /out/pog-anchor \
    && touch -d "@${SOURCE_DATE_EPOCH}" /out/pog-anchor \
    && (cd /out && sha256sum pog-anchor > SHA256SUMS)

# Strictly minimal zero-shell, zero-SSH runtime image (`FROM scratch`)
FROM scratch AS runtime
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/pog-anchor /usr/local/bin/pog-anchor
COPY --from=builder /out/SHA256SUMS /etc/pog/SHA256SUMS
ENTRYPOINT ["/usr/local/bin/pog-anchor"]
CMD ["--cloud-provider", "aws", "--vsock-port", "7443"]
