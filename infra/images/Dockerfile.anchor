# Reproducible static zero-shell, zero-SSH binary builder for AWS Nitro Enclaves (.eif)
# and immutable Confidential VM containers (AMD SEV-SNP / Intel TDX).
#
# Security Invariants (enforced by scripts/release_gate.py):
# - NEVER passes --allow-dev-tee or --allow-dev-prover inside the production image.
# - Final runtime stage is `FROM scratch`: ZERO SSH server (`sshd`), ZERO `/bin/sh` or
#   interactive shell, ZERO package manager, ZERO remote command agent inside the measured image.
# - Static musl `pog-anchor` binary compiled with deterministic SOURCE_DATE_EPOCH and
#   remapped paths; host proc-macros build on glibc while the target binary links static musl.
FROM rust:1.94-bookworm AS builder
ARG TARGETARCH=amd64
RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
         amd64) rustup target add x86_64-unknown-linux-musl ;; \
         arm64) rustup target add aarch64-unknown-linux-musl ;; \
         *) echo "Unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
       esac
WORKDIR /src
ENV SOURCE_DATE_EPOCH=1700000000 \
    TZ=UTC \
    LC_ALL=C \
    CARGO_INCREMENTAL=0 \
    CARGO_NET_RETRY=5 \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="--remap-path-prefix=/src=/pog -C target-feature=+crt-static -C debuginfo=0 -C strip=symbols -C codegen-units=1" \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="--remap-path-prefix=/src=/pog -C target-feature=+crt-static -C debuginfo=0 -C strip=symbols -C codegen-units=1"
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY config ./config
RUN case "${TARGETARCH}" in \
      amd64) MUSL_TARGET="x86_64-unknown-linux-musl" ;; \
      arm64) MUSL_TARGET="aarch64-unknown-linux-musl" ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && cargo build --release --locked --target "${MUSL_TARGET}" --bin pog-anchor \
    && mkdir -p /out \
    && cp "target/${MUSL_TARGET}/release/pog-anchor" /out/pog-anchor \
    && touch -d "@${SOURCE_DATE_EPOCH}" /out/pog-anchor \
    && (cd /out && sha256sum pog-anchor > SHA256SUMS)

# Strictly minimal zero-shell, zero-SSH runtime image for GCP Confidential Space Intel TDX (`FROM scratch`).
# Reads `POG_ANCHOR_ID` from allowlisted env_override so `cmd_override` remains strictly empty `[]`!
FROM scratch AS runtime-gcp-tdx
LABEL org.opencontainers.image.source="https://github.com/jperla/proof-of-geography" \
      org.opencontainers.image.description="Reproducible zero-shell, zero-SSH static musl Proof of Geography GCP Confidential Space Intel TDX Anchor" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/pog-anchor /usr/local/bin/pog-anchor
COPY --from=builder /out/SHA256SUMS /etc/pog/SHA256SUMS
ENTRYPOINT ["/usr/local/bin/pog-anchor"]
CMD ["--cloud-provider", "gcp", "--tcp-listen", "0.0.0.0:7443", "--udp-bind", "0.0.0.0:7444", "--udp-port-min", "40000", "--udp-port-max", "40999", "--http-info-listen", "0.0.0.0:7445"]

# Strictly minimal zero-shell, zero-SSH runtime image for AWS Nitro Enclaves (`FROM scratch`)
FROM scratch AS runtime
LABEL org.opencontainers.image.source="https://github.com/jperla/proof-of-geography" \
      org.opencontainers.image.description="Reproducible zero-shell, zero-SSH static musl Proof of Geography Anchor TEE image" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/pog-anchor /usr/local/bin/pog-anchor
COPY --from=builder /out/SHA256SUMS /etc/pog/SHA256SUMS
ENTRYPOINT ["/usr/local/bin/pog-anchor"]
CMD ["--cloud-provider", "aws", "--vsock-port", "7443"]
